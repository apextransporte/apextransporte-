<section id="members-status">
  <h2>Apex Members</h2>
  <p id="ms-count">Loading...</p>

  <h3>Official members</h3>
  <div class="ms-grid" id="ms-official"></div>

  <h3>Visitors (not yet Apex members)</h3>
  <div class="ms-grid" id="ms-visitors"></div>
</section>

<style>
  #members-status { padding: 24px 16px; color: #fff; }
  #members-status h2 { color: #e10600; margin: 0 0 8px; }
  #members-status h3 { margin: 24px 0 10px; border-left: 4px solid #e10600; padding-left: 10px; }
  #ms-count { margin: 0; opacity: 0.8; }
  .ms-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .ms-card { display: flex; align-items: center; gap: 10px; background: #141414; border: 1px solid #2a2a2a; border-radius: 10px; padding: 8px 10px; }
  .ms-card.visitor { opacity: 0.75; border-style: dashed; }
  .ms-card img, .ms-card .ms-ph { width: 36px; height: 36px; border-radius: 50%; background: #e10600; flex: none; object-fit: cover; }
  .ms-card span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ms-empty { opacity: 0.6; }
</style>

<script>
(function () {
  function card(person, isVisitor) {
    var el = document.createElement("div");
    el.className = "ms-card" + (isVisitor ? " visitor" : "");
    var pic;
    if (person.avatar) {
      pic = document.createElement("img");
      pic.src = person.avatar;
      pic.alt = "";
      pic.loading = "lazy";
    } else {
      pic = document.createElement("div");
      pic.className = "ms-ph";
    }
    var name = document.createElement("span");
    name.textContent = person.name;
    el.appendChild(pic);
    el.appendChild(name);
    return el;
  }

  function fill(id, list, isVisitor) {
    var box = document.getElementById(id);
    box.innerHTML = "";
    if (!list.length) {
      var empty = document.createElement("p");
      empty.className = "ms-empty";
      empty.textContent = "No one here yet.";
      box.appendChild(empty);
      return;
    }
    list.forEach(function (p) { box.appendChild(card(p, isVisitor)); });
  }

  fetch("members.json?t=" + Date.now(), { cache: "no-store" })
    .then(function (r) {
      if (!r.ok) { throw new Error("members.json not found"); }
      return r.json();
    })
    .then(function (d) {
      document.getElementById("ms-count").textContent =
        d.member_count + " official members, " + d.visitor_count + " visitors";
      fill("ms-official", d.members || [], false);
      fill("ms-visitors", d.visitors || [], true);
    })
    .catch(function (e) {
      document.getElementById("ms-count").textContent = "Could not load members: " + e.message;
    });
})();
</script>
